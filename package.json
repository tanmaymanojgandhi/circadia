{
  "name": "circadia",
  "version": "2.0.1",
  "private": true,
  "description": "OKLCH color themes for code editors, terminals, and document renderers, with automated contrast checks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanmaymanojgandhi/circadia.git"
  },
  "homepage": "https://github.com/tanmaymanojgandhi/circadia#readme",
  "bugs": {
    "url": "https://github.com/tanmaymanojgandhi/circadia/issues"
  },
  "scripts": {
    "lint": "node scripts/lint.js",
    "prepare": "node scripts/setup-hooks.js",
    "validate": "tsx scripts/validate.ts",
    "test:light": "node scripts/test-light-theme.cjs",
    "generate": "tsx scripts/generate-formats.ts",
    "build": "tsx scripts/generate-formats.ts",
    "lint:contrast": "tsx scripts/validate.ts",
    "build:vscode": "node ports/vscode/scripts/build-theme.js",
    "package:vscode": "npm --prefix ports/vscode run package",
    "publish:vscode": "npm --prefix ports/vscode run publish",
    "build:ports": "node scripts/build-all-ports.js"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/node": "^20.14.0",
    "luaparse": "^0.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
