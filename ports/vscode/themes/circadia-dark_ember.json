  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#bab6ae",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#83bfd5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#dfbb87"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#c3abe0"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "entity.name.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#ddabc2"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#cbc9c4"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#a9c98e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#e0b27c"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#83bfd5"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#d4d3cf",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#cecdc9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#c8c7c3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#c2c1bd"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#bcbbb7"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#b6b5b1"
      }
    }
  ]
}