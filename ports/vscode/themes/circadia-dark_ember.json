{
  "name": "Circadia — Dark Classic (Warm Ember & Espresso)",
  "type": "dark",
  "colors": {
    "editor.background": "#17130f",
    "editor.foreground": "#c9c0b1",
    "editorLineNumber.foreground": "#91887d",
    "editorLineNumber.activeForeground": "#e89a49",
    "editorCursor.foreground": "#e89a49",
    "editor.selectionBackground": "#29241e",
    "editor.selectionHighlightBackground": "#29241e99",
    "editor.wordHighlightBackground": "#29241e66",
    "editor.wordHighlightStrongBackground": "#29241e88",
    "sideBar.background": "#1e1a15",
    "sideBar.foreground": "#aba195",
    "sideBar.border": "#3b342b",
    "activityBar.background": "#1e1a15",
    "activityBar.foreground": "#c9c0b1",
    "activityBarBadge.background": "#e89a49",
    "activityBarBadge.foreground": "#17130f",
    "tab.activeBackground": "#17130f",
    "tab.inactiveBackground": "#1e1a15",
    "tab.activeBorder": "#e89a49",
    "tab.unfocusedActiveBorder": "#e89a4980",
    "editorGroupHeader.tabsBackground": "#1e1a15",
    "panel.background": "#1e1a15",
    "panel.border": "#3b342b",
    "editorWidget.background": "#1e1a15",
    "input.background": "#29241e",
    "input.foreground": "#c9c0b1",
    "input.border": "#3b342b",
    "focusBorder": "#e89a49",
    "textLink.foreground": "#e89a49",
    "progressBar.background": "#e89a49",
    "scrollbarSlider.activeBackground": "#e89a4966",
    "editorIndentGuide.background": "#3b342b",
    "editorIndentGuide.activeBackground": "#91887d",
    "editorBracketMatch.border": "#e89a49",
    "editorBracketMatch.background": "#00000000",
    "statusBar.background": "#1e1a15",
    "statusBar.foreground": "#aba195",
    "statusBarItem.remoteBackground": "#e89a49",
    "statusBarItem.remoteForeground": "#17130f",
    "list.highlightForeground": "#e89a49",
    "list.activeSelectionBackground": "#29241e",
    "list.inactiveSelectionBackground": "#1e1a15",
    "editorSuggestWidget.selectedBackground": "#29241e",
    "editorSuggestWidget.highlightForeground": "#e89a49",
    "quickInputList.focusBackground": "#29241e",
    "peekViewResult.selectionBackground": "#29241e",
    "titleBar.activeBackground": "#1e1a15",
    "titleBar.activeForeground": "#c9c0b1"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a69c91",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#66abc6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#d9a86e"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b991db"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "entity.name.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#de88a6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#c9c0b1"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#8cbb62"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#d99148"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#66abc6"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#f8c88f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#f2b26c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#ea9d49",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#db8935"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#c7792e"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#b56f2b"
      }
    }
  ]
}