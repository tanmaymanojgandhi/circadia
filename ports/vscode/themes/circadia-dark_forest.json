{
  "name": "Circadia — Dark Focus (Obsidian Pine)",
  "type": "dark",
  "colors": {
    "editor.background": "#131714",
    "editor.foreground": "#c4ccc5",
    "editorLineNumber.foreground": "#838d85",
    "editorLineNumber.activeForeground": "#83b384",
    "editorCursor.foreground": "#83b384",
    "editor.selectionBackground": "#242a25",
    "editor.selectionHighlightBackground": "#242a2599",
    "editor.wordHighlightBackground": "#242a2566",
    "editor.wordHighlightStrongBackground": "#242a2588",
    "sideBar.background": "#1a1e1b",
    "sideBar.foreground": "#9fa9a1",
    "sideBar.border": "#353c36",
    "activityBar.background": "#1a1e1b",
    "activityBar.foreground": "#c4ccc5",
    "activityBarBadge.background": "#83b384",
    "activityBarBadge.foreground": "#131714",
    "tab.activeBackground": "#131714",
    "tab.inactiveBackground": "#1a1e1b",
    "tab.activeBorder": "#83b384",
    "tab.unfocusedActiveBorder": "#83b38480",
    "editorGroupHeader.tabsBackground": "#1a1e1b",
    "panel.background": "#1a1e1b",
    "panel.border": "#353c36",
    "editorWidget.background": "#1a1e1b",
    "input.background": "#242a25",
    "input.foreground": "#c4ccc5",
    "input.border": "#353c36",
    "focusBorder": "#83b384",
    "textLink.foreground": "#83b384",
    "progressBar.background": "#83b384",
    "scrollbarSlider.activeBackground": "#83b38466",
    "editorIndentGuide.background": "#353c36",
    "editorIndentGuide.activeBackground": "#838d85",
    "editorBracketMatch.border": "#83b384",
    "editorBracketMatch.background": "#00000000",
    "statusBar.background": "#1a1e1b",
    "statusBar.foreground": "#9fa9a1",
    "statusBarItem.remoteBackground": "#83b384",
    "statusBarItem.remoteForeground": "#131714",
    "list.highlightForeground": "#83b384",
    "list.activeSelectionBackground": "#242a25",
    "list.inactiveSelectionBackground": "#1a1e1b",
    "editorSuggestWidget.selectedBackground": "#242a25",
    "editorSuggestWidget.highlightForeground": "#83b384",
    "quickInputList.focusBackground": "#242a25",
    "peekViewResult.selectionBackground": "#242a25",
    "titleBar.activeBackground": "#1a1e1b",
    "titleBar.activeForeground": "#c4ccc5"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#909890",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#6cb0c5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#d1aa73"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b29ace"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "entity.name.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#d092a9"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#c4ccc5"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#92b87e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#d19b66"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6cb0c5"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#b8e2c4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#9ecfae",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#83bc97",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#69a881"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#569970"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#45875e"
      }
    }
  ]
}