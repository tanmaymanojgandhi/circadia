{
  "name": "Circadia — Dark Modern (Plum Noir)",
  "type": "dark",
  "colors": {
    "editor.background": "#140e12",
    "editor.foreground": "#d8c8d2",
    "editorLineNumber.foreground": "#9a8b96",
    "editorLineNumber.activeForeground": "#e88cb8",
    "editorCursor.foreground": "#e88cb8",
    "editor.selectionBackground": "#261e23",
    "editor.selectionHighlightBackground": "#261e2399",
    "editor.wordHighlightBackground": "#261e2366",
    "editor.wordHighlightStrongBackground": "#261e2388",
    "sideBar.background": "#1b1419",
    "sideBar.foreground": "#b4a3af",
    "sideBar.border": "#3d3039",
    "activityBar.background": "#1b1419",
    "activityBar.foreground": "#d8c8d2",
    "activityBarBadge.background": "#e88cb8",
    "activityBarBadge.foreground": "#140e12",
    "tab.activeBackground": "#140e12",
    "tab.inactiveBackground": "#1b1419",
    "tab.activeBorder": "#e88cb8",
    "tab.unfocusedActiveBorder": "#e88cb880",
    "editorGroupHeader.tabsBackground": "#1b1419",
    "panel.background": "#1b1419",
    "panel.border": "#3d3039",
    "editorWidget.background": "#1b1419",
    "input.background": "#261e23",
    "input.foreground": "#d8c8d2",
    "input.border": "#3d3039",
    "focusBorder": "#e88cb8",
    "textLink.foreground": "#e88cb8",
    "progressBar.background": "#e88cb8",
    "scrollbarSlider.activeBackground": "#e88cb866",
    "editorIndentGuide.background": "#3d3039",
    "editorIndentGuide.activeBackground": "#9a8b96",
    "editorBracketMatch.border": "#e88cb8",
    "editorBracketMatch.background": "#00000000",
    "statusBar.background": "#1b1419",
    "statusBar.foreground": "#b4a3af",
    "statusBarItem.remoteBackground": "#e88cb8",
    "statusBarItem.remoteForeground": "#140e12",
    "list.highlightForeground": "#e88cb8",
    "list.activeSelectionBackground": "#261e23",
    "list.inactiveSelectionBackground": "#1b1419",
    "editorSuggestWidget.selectedBackground": "#261e23",
    "editorSuggestWidget.highlightForeground": "#e88cb8",
    "quickInputList.focusBackground": "#261e23",
    "peekViewResult.selectionBackground": "#261e23",
    "titleBar.activeBackground": "#1b1419",
    "titleBar.activeForeground": "#d8c8d2"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ad9ca8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#82b4ea",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e5b084"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#cb94f0"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "entity.name.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#f08bb2"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d8c8d2"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#9ec97b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#f0a256"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#82b4ea"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#f5b8d0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#e89bb8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#da7ea0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#c96588"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#b84e72"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#bd5478"
      }
    }
  ]
}