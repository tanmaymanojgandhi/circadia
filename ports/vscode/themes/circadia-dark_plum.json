  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a5999f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#75acd2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#daa97a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b695cf"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "entity.name.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#d38da4"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d8c8d2"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#96b77b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#d49969"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#75acd2"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#fabcd8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#e8a8c5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#d793b3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#c381a0"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#ad718d"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#9b647e"
      }
    }
  ]
}