{
  "name": "Circadia — Dark Modern (Plum Noir)",
  "type": "dark",
  "colors": {
    "editor.background": "#140e12",
    "editor.foreground": "#d8c8d2",
    "editorLineNumber.foreground": "#9a8b96",
    "editorLineNumber.activeForeground": "#cf8aa4",
    "editorCursor.foreground": "#cf8aa4",
    "editor.selectionBackground": "#261e23",
    "editor.selectionHighlightBackground": "#261e2399",
    "editor.wordHighlightBackground": "#261e2366",
    "editor.wordHighlightStrongBackground": "#261e2388",
    "sideBar.background": "#1b1419",
    "sideBar.foreground": "#b4a3af",
    "sideBar.border": "#3d3039",
    "activityBar.background": "#1b1419",
    "activityBar.foreground": "#d8c8d2",
    "activityBarBadge.background": "#cf8aa4",
    "activityBarBadge.foreground": "#140e12",
    "tab.activeBackground": "#140e12",
    "tab.inactiveBackground": "#1b1419",
    "tab.activeBorder": "#cf8aa4",
    "tab.unfocusedActiveBorder": "#cf8aa480",
    "editorGroupHeader.tabsBackground": "#1b1419",
    "panel.background": "#1b1419",
    "panel.border": "#3d3039",
    "editorWidget.background": "#1b1419",
    "input.background": "#261e23",
    "input.foreground": "#d8c8d2",
    "input.border": "#3d3039",
    "focusBorder": "#cf8aa4",
    "textLink.foreground": "#cf8aa4",
    "progressBar.background": "#cf8aa4",
    "scrollbarSlider.activeBackground": "#cf8aa466",
    "editorIndentGuide.background": "#3d3039",
    "editorIndentGuide.activeBackground": "#9a8b96",
    "editorBracketMatch.border": "#cf8aa4",
    "editorBracketMatch.background": "#00000000",
    "statusBar.background": "#1b1419",
    "statusBar.foreground": "#b4a3af",
    "statusBarItem.remoteBackground": "#cf8aa4",
    "statusBarItem.remoteForeground": "#140e12",
    "list.highlightForeground": "#cf8aa4",
    "list.activeSelectionBackground": "#261e23",
    "list.inactiveSelectionBackground": "#1b1419",
    "editorSuggestWidget.selectedBackground": "#261e23",
    "editorSuggestWidget.highlightForeground": "#cf8aa4",
    "quickInputList.focusBackground": "#261e23",
    "peekViewResult.selectionBackground": "#261e23",
    "titleBar.activeBackground": "#1b1419",
    "titleBar.activeForeground": "#d8c8d2"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a5999f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#75acd2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#daa97a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b695cf"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "entity.name.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#d38da4"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d8c8d2"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#96b77b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#d49969"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#75acd2"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#fabcd8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#e8a8c5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#d793b3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#c381a0"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#ad718d"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#9b647e"
      }
    }
  ]
}