{
  "name": "Circadia — Warm Parchment",
  "type": "light",
  "colors": {
    "editor.background": "#f7f2e6",
    "editor.foreground": "#28323a",
    "editorLineNumber.foreground": "#5f6d7a",
    "editorLineNumber.activeForeground": "#46535f",
    "editor.selectionBackground": "#e5dcc6",
    "editorCursor.foreground": "#0048b3",
    "sideBar.background": "#eee7d6",
    "sideBar.foreground": "#46535f",
    "sideBar.border": "#d7cdb7",
    "activityBar.background": "#eee7d6",
    "activityBar.foreground": "#28323a",
    "tab.activeBackground": "#f7f2e6",
    "tab.inactiveBackground": "#eee7d6",
    "tab.activeBorder": "#0048b3",
    "editorGroupHeader.tabsBackground": "#eee7d6",
    "panel.background": "#eee7d6",
    "panel.border": "#d7cdb7",
    "editorWidget.background": "#eee7d6",
    "input.background": "#e5dcc6",
    "input.foreground": "#28323a",
    "input.border": "#d7cdb7",
    "focusBorder": "#0048b3",
    "textLink.foreground": "#0048b3",
    "editorIndentGuide.background": "#d7cdb7",
    "editorIndentGuide.activeBackground": "#5f6d7a",
    "editorBracketMatch.border": "#0048b3",
    "statusBar.background": "#eee7d6",
    "statusBar.foreground": "#46535f",
    "titleBar.activeBackground": "#eee7d6",
    "titleBar.activeForeground": "#28323a"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5e564d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#0048b3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#843900"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7a1f7a"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "entity.name.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4b1fa3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#364450"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#005f2f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#095b62"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0048b3"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#1c4470",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#20538a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#1c60a2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#236bb5"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#286fc0"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#2f75c6"
      }
    }
  ]
}