  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4c453c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#003fa0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#763200"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#781c78"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "entity.name.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4b1fa3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#364450"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#015228"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#014e55"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#003fa0"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#0d2a46",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#0d2f50",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#0e355b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#0f3a66"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#134073"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#15477e"
      }
    }
  ]
}