  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#524b42",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#0048b3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#843900"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7a1f7a"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "entity.name.variable.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4b1fa3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#364450"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#005f2f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#095b62"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0048b3"
      }
    },
    {
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#1c4470",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#20538a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#1c60a2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#236bb5"
      }
    },
    {
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#286fc0"
      }
    },
    {
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#2f75c6"
      }
    }
  ]
}